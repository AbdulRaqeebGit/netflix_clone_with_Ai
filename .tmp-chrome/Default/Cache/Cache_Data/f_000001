@import url("../fonts/fonts.css");

/* =========================================================
   Cineflix design system
   ========================================================= */
:root {
  --cf-red: #e50914;
  --cf-red-hover: #f6121d;
  --cf-red-dark: #b20710;
  --cf-black: #000;
  --cf-bg: #0b0b0f;
  --cf-bg-soft: #141414;
  --cf-surface: #181818;
  --cf-surface-2: #232323;
  --cf-text: #ffffff;
  --cf-muted: #b3b3b3;
  --cf-muted-2: #8c8c8c;
  --cf-line: rgba(255, 255, 255, 0.14);
  --cf-green: #46d369;
  --cf-gold: #e6b34b;
  --cf-font-display: "Bebas Neue", "Arial Narrow", Impact, sans-serif;
  --cf-font-body: "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --cf-radius: 6px;
  --cf-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
  --cf-max: 1280px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--cf-black);
  color: var(--cf-text);
  font-family: var(--cf-font-body);
  font-size: 16px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body.no-scroll {
  overflow: hidden;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  color: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

::selection {
  background: var(--cf-red);
  color: #fff;
}

:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 3px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.hidden,
[hidden] {
  display: none !important;
}

.cf-container {
  width: min(var(--cf-max), 100%);
  margin-inline: auto;
  padding-inline: 24px;
}

/* Brand */
.brand-word {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  color: var(--cf-red);
  font-family: var(--cf-font-display);
  font-size: 32px;
  line-height: 0.9;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  white-space: nowrap;
  text-shadow: 0 2px 18px rgba(229, 9, 20, 0.25);
}

.brand-word:hover {
  color: var(--cf-red-hover);
}

.brand-word .brand-dot {
  width: 5px;
  height: 5px;
  margin-left: 3px;
  margin-top: 16px;
  border-radius: 50%;
  background: currentColor;
}

.brand-word--lg {
  font-size: 44px;
  letter-spacing: 2.2px;
}

/* Buttons */
.btn-cf {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 46px;
  padding: 0 22px;
  border: 0;
  border-radius: 4px;
  background: var(--cf-red);
  color: #fff;
  font-weight: 600;
  font-size: 0.98rem;
  line-height: 1;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-cf:hover {
  background: var(--cf-red-hover);
  box-shadow: 0 10px 28px rgba(229, 9, 20, 0.23);
}

.btn-cf:active {
  transform: translateY(1px);
}

.btn-cf svg {
  width: 18px;
  height: 18px;
}

.btn-cf--wide {
  width: 100%;
}

.btn-cf--lg {
  min-height: 58px;
  padding: 0 28px;
  font-size: 1.3rem;
  font-weight: 700;
}

.btn-cf--outline {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.45);
}

.btn-cf--outline:hover {
  background: rgba(255, 255, 255, 0.1);
  box-shadow: none;
}

.btn-cf--ghost {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.btn-cf--ghost:hover {
  background: rgba(255, 255, 255, 0.18);
  box-shadow: none;
}

.btn-cf--light {
  background: #fff;
  color: #111;
}

.btn-cf--light:hover {
  background: #e6e6e6;
  color: #111;
  box-shadow: 0 10px 28px rgba(255, 255, 255, 0.12);
}

.text-link {
  color: #fff;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-thickness: 1px;
}

.text-link:hover {
  color: #d7d7d7;
}

.text-link--muted {
  color: var(--cf-muted);
  font-weight: 400;
}

/* Generic icon helper */
.cf-icon {
  width: 22px;
  height: 22px;
  display: inline-block;
  flex: 0 0 auto;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* =========================================================
   Backgrounds
   ========================================================= */
.auth-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  background: #050506;
}

.auth-collage,
.landing-collage {
  position: fixed;
  inset: -3%;
  z-index: 0;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  grid-auto-rows: 1fr;
  gap: 3px;
  opacity: 0.54;
  filter: saturate(0.82) blur(1.1px);
  transform: scale(1.04);
  pointer-events: none;
}

.auth-collage img,
.landing-collage img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.8;
}

.auth-shade {
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(60% 60% at 50% 30%, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.72) 72%),
    linear-gradient(180deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.45) 38%, rgba(0, 0, 0, 0.94) 100%);
}

.auth-shade::after {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.16;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");
  mix-blend-mode: soft-light;
}

/* =========================================================
   Site navigation (marketing + auth)
   ========================================================= */
.site-nav {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 60;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 22px 4.8%;
  transition: background 0.3s ease, padding 0.3s ease, backdrop-filter 0.3s ease;
}

.site-nav.is-scrolled {
  padding-block: 13px;
  background: rgba(5, 5, 7, 0.9);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.site-nav--auth {
  position: absolute;
  padding-top: 28px;
}

.site-nav__right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.site-nav__back {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: rgba(255, 255, 255, 0.75);
  font-size: 0.88rem;
  font-weight: 500;
}

.site-nav__back:hover {
  color: #fff;
}

.site-nav__back svg {
  width: 16px;
  height: 16px;
}

/* =========================================================
   Landing page
   ========================================================= */
.landing-page {
  position: relative;
  background: #000;
}

.landing-collage {
  opacity: 0.42;
  filter: saturate(0.78) blur(1.4px);
}

.landing-shade {
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(75% 65% at 50% 26%, rgba(0, 0, 0, 0.22) 0%, rgba(0, 0, 0, 0.78) 76%),
    linear-gradient(180deg, rgba(0, 0, 0, 0.48) 0%, rgba(0, 0, 0, 0.55) 40%, #000 96%);
}

.landing-main {
  position: relative;
  z-index: 2;
}

.landing-hero {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  padding: 130px 24px 90px;
  text-align: center;
}

.landing-hero__inner {
  width: min(860px, 100%);
  animation: heroIn 0.8s 0.1s both cubic-bezier(0.22, 1, 0.36, 1);
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  color: #f0d8b7;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 3.4px;
  text-transform: uppercase;
}

.eyebrow::before,
.eyebrow::after {
  content: "";
  width: 28px;
  height: 1px;
  background: rgba(240, 216, 183, 0.5);
}

.landing-hero h1 {
  margin: 0;
  font-size: clamp(2.9rem, 6.2vw, 5.35rem);
  font-weight: 800;
  letter-spacing: -0.055em;
  line-height: 1.02;
  text-wrap: balance;
  text-shadow: 0 8px 40px rgba(0, 0, 0, 0.55);
}

.landing-hero h1 span {
  display: block;
  color: #fff;
}

.landing-hero h1 em {
  font-style: normal;
  color: #e8c897;
}

.landing-hero__sub {
  margin: 22px auto 0;
  max-width: 650px;
  color: rgba(255, 255, 255, 0.82);
  font-size: clamp(1rem, 1.6vw, 1.2rem);
  font-weight: 400;
}

.landing-hero__price {
  margin: 16px auto 30px;
  color: #fff;
  font-size: 1.02rem;
  font-weight: 500;
}

.landing-hero__prompt {
  margin: 0 0 14px;
  color: rgba(255, 255, 255, 0.9);
  font-size: 0.98rem;
}

.email-cta {
  display: flex;
  width: min(650px, 100%);
  margin: 0 auto;
  gap: 9px;
}

.email-cta__shell {
  position: relative;
  flex: 1 1 auto;
}

.email-cta__shell svg {
  position: absolute;
  top: 50%;
  left: 18px;
  width: 20px;
  height: 20px;
  transform: translateY(-50%);
  color: rgba(255, 255, 255, 0.55);
  pointer-events: none;
}

.email-cta input {
  width: 100%;
  height: 62px;
  padding: 0 18px 0 50px;
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 4px;
  background: rgba(18, 18, 20, 0.82);
  color: #fff;
  font-size: 1rem;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.email-cta input::placeholder {
  color: rgba(255, 255, 255, 0.55);
}

.email-cta input:focus {
  border-color: #fff;
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.09);
  outline: none;
}

.email-cta .btn-cf {
  flex: 0 0 auto;
  height: 62px;
  padding-inline: 28px;
  font-size: 1.28rem;
  font-weight: 700;
}

.email-cta .btn-cf svg {
  width: 21px;
  height: 21px;
  transition: transform 0.2s ease;
}

.email-cta .btn-cf:hover svg {
  transform: translateX(2px);
}

.landing-hero__note {
  margin: 18px 0 0;
  color: var(--cf-muted);
  font-size: 0.82rem;
}

.landing-hero__note a {
  color: #e1b982;
  font-weight: 600;
}

.landing-hero__note a:hover {
  text-decoration: underline;
}

.hero-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin-top: 30px;
}

.hero-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 12px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.32);
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.72rem;
  font-weight: 500;
  backdrop-filter: blur(8px);
}

.hero-chip svg {
  width: 14px;
  height: 14px;
  color: #e1b982;
}

.landing-content {
  position: relative;
  z-index: 2;
  background: #000;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.landing-section {
  width: min(1180px, 100%);
  margin-inline: auto;
  padding: 78px 30px;
}

.landing-section + .landing-section {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(1.6rem, 3vw, 2.15rem);
  font-weight: 700;
  letter-spacing: -0.03em;
}

.section-heading p {
  margin: 7px 0 0;
  color: var(--cf-muted);
  font-size: 0.92rem;
}

.section-heading__link {
  flex: 0 0 auto;
  color: #e1b982;
  font-size: 0.83rem;
  font-weight: 600;
}

.section-heading__link:hover {
  text-decoration: underline;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.feature-card {
  min-height: 220px;
  padding: 26px 22px;
  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 10px;
  background: linear-gradient(150deg, #1d1d20 0%, #111113 78%);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.2);
}

.feature-card__icon {
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  margin-bottom: 22px;
  border-radius: 10px;
  background: rgba(229, 9, 20, 0.12);
  color: #f08080;
}

.feature-card__icon svg {
  width: 23px;
  height: 23px;
}

.feature-card h3 {
  margin: 0 0 8px;
  font-size: 1.07rem;
  font-weight: 600;
}

.feature-card p {
  margin: 0;
  color: var(--cf-muted);
  font-size: 0.87rem;
  line-height: 1.6;
}

.trending-strip {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
}

.trending-poster {
  position: relative;
  display: block;
  overflow: hidden;
  border-radius: 5px;
  aspect-ratio: 2 / 3;
  background: #202024;
  isolation: isolate;
}

.trending-poster img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.45s ease, filter 0.45s ease;
}

.trending-poster::after {
  content: "";
  position: absolute;
  inset: 50% 0 0;
  z-index: 1;
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.9));
  pointer-events: none;
}

.trending-poster__title {
  position: absolute;
  right: 10px;
  bottom: 10px;
  left: 10px;
  z-index: 2;
  font-size: 0.78rem;
  font-weight: 600;
  line-height: 1.3;
  text-shadow: 0 2px 8px #000;
}

.trending-poster__lock {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 3;
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.7);
  color: rgba(255, 255, 255, 0.8);
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.trending-poster__lock svg {
  width: 14px;
  height: 14px;
}

.trending-poster:hover img {
  transform: scale(1.055);
  filter: brightness(0.72);
}

.trending-poster:hover .trending-poster__lock {
  opacity: 1;
  transform: none;
}

.faq-wrap {
  width: min(880px, 100%);
  margin-inline: auto;
}

.faq-list {
  display: grid;
  gap: 8px;
}

.faq-item {
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 6px;
  background: #161618;
  overflow: hidden;
}

.faq-item summary {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 24px;
  font-size: 1.04rem;
  font-weight: 500;
  cursor: pointer;
  list-style: none;
}

.faq-item summary::-webkit-details-marker {
  display: none;
}

.faq-item summary::after {
  content: "+";
  flex: 0 0 auto;
  color: var(--cf-muted);
  font-size: 1.8rem;
  font-weight: 300;
  line-height: 1;
  transition: transform 0.25s ease;
}

.faq-item[open] summary::after {
  transform: rotate(45deg);
}

.faq-item__answer {
  padding: 0 24px 22px;
  color: var(--cf-muted);
  font-size: 0.9rem;
  line-height: 1.7;
}

.faq-item[open] {
  background: #1d1d20;
}

.faq-note {
  margin: 26px auto 0;
  color: var(--cf-muted);
  text-align: center;
  font-size: 0.85rem;
}

.landing-footer {
  width: min(1180px, 100%);
  margin-inline: auto;
  padding: 46px 30px 64px;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  color: #8e8e8e;
  font-size: 0.8rem;
}

.landing-footer__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px 26px;
  margin: 22px 0 30px;
}

.landing-footer__grid a:hover {
  text-decoration: underline;
}

.landing-footer__bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  font-size: 0.72rem;
  color: #6f6f6f;
}

.landing-footer__brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
  color: var(--cf-red);
  font-family: var(--cf-font-display);
  font-size: 26px;
  letter-spacing: 1.4px;
}

/* =========================================================
   Auth pages
   ========================================================= */
.auth-main {
  position: relative;
  z-index: 2;
  display: flex;
  min-height: 100vh;
  align-items: flex-start;
  justify-content: center;
  padding: 118px 20px 64px;
}

.auth-card {
  width: min(460px, 100%);
  padding: 46px 56px 38px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 8px;
  background: rgba(5, 5, 6, 0.82);
  box-shadow: var(--cf-shadow);
  backdrop-filter: blur(14px);
  animation: cardIn 0.55s both cubic-bezier(0.22, 1, 0.36, 1);
}

.auth-card--signup {
  width: min(510px, 100%);
}

.auth-card h1 {
  margin: 0;
  font-size: clamp(1.75rem, 4vw, 2.15rem);
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.15;
}

.auth-card__sub {
  margin: 10px 0 26px;
  color: var(--cf-muted);
  font-size: 0.9rem;
  line-height: 1.55;
}

.auth-card__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 10px;
  color: #e1b982;
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 2.2px;
  text-transform: uppercase;
}

.auth-card__eyebrow svg {
  width: 14px;
  height: 14px;
}

.auth-form {
  display: grid;
  gap: 14px;
}

.nf-field {
  position: relative;
}

.nf-field input {
  width: 100%;
  height: 58px;
  padding: 21px 50px 7px 16px;
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 4px;
  background: rgba(23, 23, 25, 0.82);
  color: #fff;
  font-size: 1rem;
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.nf-field input:hover {
  border-color: rgba(255, 255, 255, 0.45);
}

.nf-field input:focus {
  border-color: #fff;
  background: rgba(28, 28, 31, 0.95);
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
  outline: none;
}

.nf-field label {
  position: absolute;
  top: 50%;
  left: 16px;
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.96rem;
  pointer-events: none;
  transform: translateY(-50%);
  transition: top 0.16s ease, transform 0.16s ease, font-size 0.16s ease;
}

.nf-field input:focus + label,
.nf-field input:not(:placeholder-shown) + label,
.nf-field input.is-filled + label {
  top: 13px;
  font-size: 0.68rem;
  letter-spacing: 0.25px;
  transform: none;
}

.nf-field__toggle {
  position: absolute;
  top: 50%;
  right: 9px;
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: rgba(255, 255, 255, 0.55);
  transform: translateY(-50%);
}

.nf-field__toggle:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.07);
}

.nf-field__toggle svg {
  width: 19px;
  height: 19px;
}

.nf-field__hint {
  margin: 6px 0 0;
  color: #8e8e8e;
  font-size: 0.7rem;
}

.field-error {
  margin: 5px 0 0;
  color: #ff9a9a;
  font-size: 0.73rem;
}

.nf-field.has-error input {
  border-color: #e87c03;
}

.password-meter {
  display: flex;
  gap: 4px;
  margin-top: 8px;
}

.password-meter span {
  height: 3px;
  flex: 1;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.14);
  transition: background 0.2s ease;
}

.password-meter[data-score="1"] span:nth-child(1) {
  background: #e50914;
}

.password-meter[data-score="2"] span:nth-child(1),
.password-meter[data-score="2"] span:nth-child(2) {
  background: #e8a33e;
}

.password-meter[data-score="3"] span:nth-child(1),
.password-meter[data-score="3"] span:nth-child(2),
.password-meter[data-score="3"] span:nth-child(3) {
  background: #e8d33e;
}

.password-meter[data-score="4"] span {
  background: var(--cf-green);
}

.auth-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-top: 2px;
  font-size: 0.76rem;
}

.checkbox-cf {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #b9b9b9;
  cursor: pointer;
  user-select: none;
}

.checkbox-cf input {
  width: 16px;
  height: 16px;
  margin: 0;
  accent-color: var(--cf-red);
  cursor: pointer;
}

.auth-link {
  color: #b9b9b9;
  font-size: 0.78rem;
}

.auth-link:hover {
  color: #fff;
  text-decoration: underline;
}

.auth-alert {
  display: none;
  padding: 11px 13px;
  border: 1px solid rgba(232, 124, 3, 0.5);
  border-radius: 4px;
  background: rgba(232, 124, 3, 0.12);
  color: #ffb86b;
  font-size: 0.8rem;
  line-height: 1.5;
}

.auth-alert.is-visible {
  display: block;
  margin-bottom: 14px;
  animation: shake 0.35s ease;
}

.auth-form > .auth-alert.is-visible {
  margin-bottom: 0;
}

.auth-alert--success {
  border-color: rgba(70, 211, 105, 0.4);
  background: rgba(70, 211, 105, 0.1);
  color: #8be7a2;
}

.auth-submit {
  margin-top: 6px;
  min-height: 48px;
  font-size: 1rem;
}

.auth-submit.is-loading {
  pointer-events: none;
  opacity: 0.8;
}

.auth-submit.is-loading::after {
  content: "";
  width: 16px;
  height: 16px;
  margin-left: 4px;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

.auth-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 20px 0 16px;
  color: #777;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  height: 1px;
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
}

.demo-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 14px;
  border: 1px dashed rgba(255, 255, 255, 0.16);
  border-radius: 5px;
  background: rgba(255, 255, 255, 0.025);
}

.demo-box__text {
  min-width: 0;
}

.demo-box__text strong {
  display: block;
  font-size: 0.75rem;
  font-weight: 600;
}

.demo-box__text span {
  display: block;
  margin-top: 2px;
  color: #8e8e8e;
  font-size: 0.68rem;
  overflow-wrap: anywhere;
}

.demo-box .btn-cf {
  min-height: 34px;
  padding: 0 12px;
  font-size: 0.72rem;
  white-space: nowrap;
}

.auth-alt {
  margin: 26px 0 0;
  color: #8d8d8d;
  font-size: 0.84rem;
}

.auth-alt a {
  color: #fff;
  font-weight: 500;
}

.auth-alt a:hover {
  text-decoration: underline;
}

.auth-fineprint {
  margin: 18px 0 0;
  color: #666;
  font-size: 0.67rem;
  line-height: 1.55;
}

.auth-footer {
  margin-top: 26px;
  padding-top: 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  color: #777;
  font-size: 0.68rem;
  text-align: center;
}

.auth-footer a {
  color: #9a9a9a;
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* Forgot password steps */
.step-dots {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
}

.step-dots__line {
  height: 1px;
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
}

.step-dots__dot {
  display: grid;
  width: 23px;
  height: 23px;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  color: #777;
  font-size: 0.64rem;
  font-weight: 600;
}

.step-dots__dot.is-active {
  border-color: var(--cf-red);
  background: var(--cf-red);
  color: #fff;
  box-shadow: 0 0 0 4px rgba(229, 9, 20, 0.13);
}

.step-dots__dot.is-done {
  border-color: var(--cf-green);
  background: rgba(70, 211, 105, 0.15);
  color: var(--cf-green);
}

.reset-step {
  display: none;
  animation: fadeIn 0.25s ease;
}

.reset-step.is-active {
  display: block;
}

.account-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  max-width: 100%;
  margin: 0 0 20px;
  padding: 7px 11px;
  border: 1px solid rgba(255, 255, 255, 0.11);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  color: #d1d1d1;
  font-size: 0.73rem;
}

.account-pill svg {
  width: 14px;
  height: 14px;
  color: var(--cf-green);
}

.account-pill span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reset-success {
  padding: 10px 0 6px;
  text-align: center;
}

.reset-success__icon {
  display: grid;
  width: 60px;
  height: 60px;
  place-items: center;
  margin: 0 auto 18px;
  border: 1px solid rgba(70, 211, 105, 0.35);
  border-radius: 50%;
  background: rgba(70, 211, 105, 0.1);
  color: var(--cf-green);
}

.reset-success__icon svg {
  width: 28px;
  height: 28px;
}

.reset-success h2 {
  margin: 0 0 8px;
  font-size: 1.35rem;
}

.reset-success p {
  margin: 0 auto 22px;
  max-width: 320px;
  color: var(--cf-muted);
  font-size: 0.85rem;
}

.back-row {
  display: flex;
  justify-content: center;
  margin-top: 18px;
}

/* =========================================================
   Toasts
   ========================================================= */
.toast-stack {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 9999;
  display: flex;
  width: min(360px, calc(100vw - 32px));
  flex-direction: column;
  gap: 9px;
  pointer-events: none;
}

.cine-toast {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 14px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  background: rgba(28, 28, 30, 0.96);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  color: #f1f1f1;
  font-size: 0.8rem;
  line-height: 1.45;
  pointer-events: auto;
  animation: toastIn 0.28s both cubic-bezier(0.22, 1, 0.36, 1);
  backdrop-filter: blur(10px);
}

.cine-toast.is-leaving {
  animation: toastOut 0.25s both ease;
}

.cine-toast__icon {
  display: grid;
  width: 22px;
  height: 22px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 50%;
  background: rgba(70, 211, 105, 0.15);
  color: var(--cf-green);
}

.cine-toast__icon svg {
  width: 13px;
  height: 13px;
}

.cine-toast--error .cine-toast__icon {
  background: rgba(229, 9, 20, 0.16);
  color: #ff8e8e;
}

.cine-toast__body {
  flex: 1;
  min-width: 0;
}

.cine-toast__body strong {
  display: block;
  margin-bottom: 1px;
  font-size: 0.78rem;
}

.cine-toast__close {
  border: 0;
  background: transparent;
  color: #888;
  cursor: pointer;
  padding: 0 2px;
  line-height: 1;
}

.cine-toast__close:hover {
  color: #fff;
}

/* =========================================================
   Animations
   ========================================================= */
@keyframes heroIn {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.99);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4px); }
  50% { transform: translateX(4px); }
  75% { transform: translateX(-2px); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes toastIn {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes toastOut {
  to {
    opacity: 0;
    transform: translateY(6px);
  }
}

/* =========================================================
   Responsive
   ========================================================= */
@media (max-width: 1080px) {
  .feature-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .trending-strip {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .auth-collage,
  .landing-collage {
    grid-template-columns: repeat(5, 1fr);
  }
}

@media (max-width: 820px) {
  .site-nav {
    padding: 18px 5%;
  }

  .brand-word {
    font-size: 27px;
    letter-spacing: 1.3px;
  }

  .brand-word--lg {
    font-size: 36px;
  }

  .landing-hero {
    min-height: 94vh;
    padding-top: 115px;
  }

  .landing-section {
    padding: 58px 22px;
  }

  .trending-strip {
    display: flex;
    overflow-x: auto;
    gap: 9px;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .trending-strip::-webkit-scrollbar {
    display: none;
  }

  .trending-poster {
    flex: 0 0 30%;
    scroll-snap-align: start;
  }

  .landing-footer__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .auth-main {
    padding-top: 105px;
  }

  .auth-card {
    padding: 36px 32px 30px;
    background: rgba(6, 6, 8, 0.88);
  }

  .auth-card--signup {
    padding-inline: 32px;
  }

  .site-nav--auth .site-nav__back span {
    display: none;
  }
}

@media (max-width: 600px) {
  .site-nav {
    padding-inline: 22px;
  }

  .landing-hero {
    padding: 108px 18px 68px;
  }

  .eyebrow {
    font-size: 0.59rem;
    letter-spacing: 2.4px;
  }

  .eyebrow::before,
  .eyebrow::after {
    width: 16px;
  }

  .landing-hero h1 {
    font-size: clamp(2.35rem, 11vw, 3.5rem);
    letter-spacing: -0.045em;
  }

  .landing-hero__sub {
    margin-top: 16px;
    font-size: 0.96rem;
  }

  .landing-hero__price {
    margin-bottom: 24px;
    font-size: 0.93rem;
  }

  .email-cta {
    flex-direction: column;
    gap: 8px;
  }

  .email-cta input,
  .email-cta .btn-cf {
    height: 54px;
    font-size: 1.05rem;
  }

  .hero-chips {
    gap: 6px;
    margin-top: 24px;
  }

  .hero-chip {
    font-size: 0.65rem;
    padding: 6px 9px;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 7px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .feature-card {
    min-height: 0;
  }

  .trending-poster {
    flex-basis: 36%;
  }

  .landing-section {
    padding: 48px 18px;
  }

  .faq-item summary {
    padding: 17px 18px;
    font-size: 0.92rem;
  }

  .faq-item__answer {
    padding: 0 18px 18px;
    font-size: 0.83rem;
  }

  .landing-footer {
    padding: 36px 20px 48px;
  }

  .landing-footer__grid {
    grid-template-columns: 1fr 1fr;
    gap: 10px 16px;
  }

  .landing-footer__bottom {
    align-items: flex-start;
    flex-direction: column;
  }

  .auth-main {
    padding: 94px 14px 40px;
  }

  .auth-card,
  .auth-card--signup {
    padding: 30px 22px 26px;
    border-radius: 6px;
  }

  .auth-card h1 {
    font-size: 1.7rem;
  }

  .demo-box {
    align-items: stretch;
    flex-direction: column;
  }

  .demo-box .btn-cf {
    width: 100%;
  }

  .toast-stack {
    right: 12px;
    bottom: 12px;
  }

  .auth-collage,
  .landing-collage {
    grid-template-columns: repeat(4, 1fr);
    opacity: 0.4;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}
